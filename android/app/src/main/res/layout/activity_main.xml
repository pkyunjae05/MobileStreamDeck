<?xml version="1.0" encoding="utf-8"?>

<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:columnCount="3"
    android:rowCount="5"
    android:padding="16dp"
    android:alignmentMode="alignBounds"
    android:useDefaultMargins="true">

    <ImageButton
        android:id="@+id/btn_action_youtube"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_row="0"
        android:layout_column="0"
        android:src="@drawable/ic_action_play"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/action_label_youtube"
        android:tag="@string/action_command_youtube" />

    <!--
        [향후 확장 예시]
        추가 버튼은 아래처럼 tag만 다르게 넣어 계속 붙이면 됨.
        MainActivity.java 쪽 코드는 수정할 필요 없음.

        <ImageButton
            android:id="@+id/btn_action_spotify"
            android:layout_row="0"
            android:layout_column="1"
            ...
            android:tag="Spotify" />
    -->

    <!-- [ADD] 하단 IP 입력 + 연결 버튼 영역. 그리드 3칸을 전부 차지하는 마지막 행에 배치. -->
    <LinearLayout
        android:layout_row="4"
        android:layout_column="0"
        android:layout_columnSpan="3"
        android:layout_gravity="fill_horizontal"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/et_ip_address"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp"
            android:hint="@string/hint_ip_address"
            android:text="@string/default_pc_ip"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="text"
            android:singleLine="true"
            android:background="#1E1E1E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_connect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB" />

    </LinearLayout>

</GridLayout>
